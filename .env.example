# Copy to .env.local for local dev; set the same keys in Vercel project settings.
# Use NEW keys — do not reuse any key from the old Lovable project.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
ANTHROPIC_API_KEY=
FOURSQUARE_API_KEY=
RESEND_API_KEY=
ENQUIRY_NOTIFY_EMAIL=
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# Local Supabase only (supabase/config.toml). In the hosted project, set Google keys in Auth > Providers.
SUPABASE_AUTH_EXTERNAL_GOOGLE_CLIENT_ID=
SUPABASE_AUTH_EXTERNAL_GOOGLE_SECRET=
