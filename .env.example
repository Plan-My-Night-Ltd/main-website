# Copy to .env.local for local dev; set the same keys in Vercel project settings.
# Use NEW keys — do not reuse any key from the old Lovable project.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
ANTHROPIC_API_KEY=
FOURSQUARE_API_KEY=
# Scripts only (scripts/enrich-booking.mts): Google Maps booking details via Apify.
APIFY_TOKEN=
RESEND_API_KEY=
ENQUIRY_NOTIFY_EMAIL=
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# Signs shared plan links so friends can open them without an account. Any long random
# string (e.g. `openssl rand -base64 32`). Falls back to SUPABASE_SERVICE_ROLE_KEY if unset;
# changing it breaks links already shared.
PLAN_SHARE_SECRET=
# Shown as "Email us" on the account page and in the privacy policy.
NEXT_PUBLIC_CONTACT_EMAIL=
# Set to true once Sign in with Apple is set up in Supabase (Auth > Providers > Apple).
NEXT_PUBLIC_APPLE_SIGN_IN=
# Local Supabase only (supabase/config.toml). In the hosted project, set Google keys in Auth > Providers.
SUPABASE_AUTH_EXTERNAL_GOOGLE_CLIENT_ID=
SUPABASE_AUTH_EXTERNAL_GOOGLE_SECRET=
